# Application Settings
PROJECT_NAME="Learn-Lynx GenAI Study Assistant"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Defaults to SQLite for local development; switch to PostgreSQL in production)
DATABASE_URL="sqlite:///./learnlynx.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learnlynx_db"

# JWT Authentication Settings
JWT_SECRET_KEY="learn-lynx-super-secret-production-grade-jwt-key-2026-change-in-prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
